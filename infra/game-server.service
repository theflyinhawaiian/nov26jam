[Unit]
Description=nov26jam dedicated game server
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/game/Server.x86_64

[Service]
User=game
WorkingDirectory=/opt/game
ExecStart=/opt/game/Server.x86_64 -batchmode -nographics -logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
